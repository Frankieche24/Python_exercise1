      "source": [
        "# Question 5: In East Africa, how does loan size relate to repayment interval and loan term?\n"
      ],
      "metadata": {
        "id": "Mt_Sj2hOk2xg"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "east = loans[loans[\"country\"].isin([\"Kenya\", \"Uganda\", \"Tanzania\", \"Rwanda\"])].copy()\n",
        "\n",
        "east[\"size_band\"] = east[\"loan_amount\"].apply(\n",
        "    lambda x: \"1 small (<300)\" if x < 300\n",
        "    else \"2 medium (300-999)\" if x < 1000\n",
        "    else \"3 large (1000+)\"\n",
        ")\n",
        "\n",
        "size_term = (\n",
        "    east.groupby([\"size_band\", \"repayment_interval\"])\n",
        "        .agg(n_loans=(\"id\", \"count\"), avg_term_months=(\"term_in_months\", \"mean\"))\n",
        "        .reset_index()\n",
        "        .sort_values([\"size_band\", \"avg_term_months\"], ascending=[True, False])\n",
        "        .round(1)\n",
        ")\n",
        "size_term"
