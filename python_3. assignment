        "# removing \"female\" first stops it from matching the word \"male\"\n",
        "g[\"group_type\"] = g[\"borrower_genders\"].apply(\n",
        "    lambda s: \"women only\" if \"male\" not in s.replace(\"female\", \"\")\n",
        "    else \"men only\" if \"female\" not in s\n",
        "    else \"mixed\"\n",
        ")\n",
        "\n",
        "by_group = (\n",
        "    g.groupby(\"group_type\")\n",
        "     .agg(n_loans=(\"id\", \"count\"),\n",
        "          median_loan=(\"loan_amount\", \"median\"),\n",
        "          mean_lenders=(\"lender_count\", \"mean\"),\n",
        "          mean_term_months=(\"term_in_months\", \"mean\"))\n",
        "     .sort_values(\"n_loans\", ascending=False)\n",
        "     .round(1)\n",
        ")\n",
        "by_group"
      ],
