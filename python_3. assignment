    {
      "cell_type": "code",
      "source": [
        "loans[\"fully_funded\"] = loans[\"funded_amount\"] >= loans[\"loan_amount\"]\n",
        "\n",
        "activities = (\n",
        "    loans.groupby(\"activity\")\n",
        "         .agg(n_loans=(\"id\", \"count\"),\n",
        "              share_not_funded=(\"fully_funded\", lambda x: 1 - x.mean()))\n",
        ")\n",
        "\n",
        "# only activities with at least 500 loans, so the shares are not based on a handful of loans\n",
        "activities = activities[activities[\"n_loans\"] >= 500].sort_values(\"share_not_funded\", ascending=False)\n",
        "print(f\"All loans: {1 - loans['fully_funded'].mean():.3f} not fully funded\")\n",
        "print(\"Lowest three activities:\")\n",
        "print(activities.tail(3).round(3))\n",
        "activities.head(10).round(3)"
      ],
