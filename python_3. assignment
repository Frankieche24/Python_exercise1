        "# Question 2: Which sectors take the longest to get fully funded?\n"
      ],
      "metadata": {
        "id": "rtZmIxZbjKZe"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "timed = loans.dropna(subset=[\"posted_time\", \"funded_time\"]).copy()\n",
        "\n",
        "# Convert time columns to datetime objects before subtraction\n",
        "timed[\"posted_time\"] = pd.to_datetime(timed[\"posted_time\"])\n",
        "timed[\"funded_time\"] = pd.to_datetime(timed[\"funded_time\"])\n",
        "\n",
        "timed[\"days_to_fund\"] = (timed[\"funded_time\"] - timed[\"posted_time\"]).dt.total_seconds() / 86400\n",
        "timed = timed[timed[\"days_to_fund\"] >= 0]\n",
        "\n",
        "speed = (\n",
        "    timed.groupby(\"sector\")[\"days_to_fund\"]\n",
        "         .agg(n_loans=\"count\", median_days=\"median\", mean_days=\"mean\")\n",
        "         .sort_values(\"median_days\", ascending=False)\n",
        "         .round(1)\n",
        ")\n",
        "speed"
