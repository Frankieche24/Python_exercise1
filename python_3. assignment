        "# Question 1: Which countries have the most large agricultural loans for seeds or fertilizer?\n"
      ],
      "metadata": {
        "id": "9MN4UboVhdAl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "farm = loans[\n",
        "    (loans[\"sector\"] == \"Agriculture\")\n",
        "    & (loans[\"loan_amount\"] > 1000)\n",
        "    & (loans[\"use\"].str.contains(\"fertilizer|seed\", case=False, na=False))\n",
        "]\n",
        "\n",
        "farm_by_country = (\n",
        "    farm.groupby(\"country\")\n",
        "        .agg(n_loans=(\"id\", \"count\"), avg_loan_amount=(\"loan_amount\", \"mean\"))\n",
        "        .sort_values(\"n_loans\", ascending=False)\n",
        "        .head(10)\n",
        "        .round(0)\n",
        ")\n",
        "print(len(farm), \"loans match\")\n",
        "farm_by_country"
      ],
