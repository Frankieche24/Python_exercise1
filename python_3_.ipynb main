      "source": [
        "east = loans[loans[\"country\"].isin([\"Kenya\", \"Uganda\", \"Tanzania\", \"Rwanda\"])].copy()\n",
        "\n",
        "east[\"size_band\"] = east[\"loan_amount\"].apply(\n",
        "    lambda x: \"1 small (<300)\" if x < 300\n",
